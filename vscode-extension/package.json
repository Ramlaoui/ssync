{
  "name": "ssync-vscode",
  "displayName": "ssync",
  "description": "Your cluster workspace: submit SLURM jobs, monitor experiments, and inspect output.",
  "version": "0.2.0",
  "icon": "media/icon.png",
  "publisher": "Ramlaoui",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ramlaoui/ssync.git"
  },
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Monitoring is available; submitting scripts, syncing files, and starting the server require workspace trust."
    }
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:ssync.openDashboard",
    "onCommand:ssync.configure",
    "onView:ssync.jobsView",
    "onCommand:ssync.syncWorkspace",
    "onCommand:ssync.submitScript",
    "onCommand:ssync.refreshJobs",
    "onCommand:ssync.viewLogs",
    "onCommand:ssync.cancelJob",
    "onCommand:ssync.startServer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ssync.openDashboard",
        "title": "Open Jobs Dashboard",
        "category": "ssync",
        "icon": "$(dashboard)"
      },
      {
        "command": "ssync.configure",
        "title": "Configure Connection",
        "category": "ssync",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ssync.syncWorkspace",
        "title": "Sync Workspace to Host",
        "category": "ssync",
        "icon": "$(sync)"
      },
      {
        "command": "ssync.submitScript",
        "title": "Submit Script to Cluster",
        "category": "ssync",
        "icon": "$(play)"
      },
      {
        "command": "ssync.refreshJobs",
        "title": "Refresh",
        "category": "ssync",
        "icon": "$(refresh)"
      },
      {
        "command": "ssync.viewLogs",
        "title": "View Logs",
        "category": "ssync",
        "icon": "$(output)"
      },
      {
        "command": "ssync.cancelJob",
        "title": "Cancel Job",
        "category": "ssync",
        "icon": "$(stop-circle)"
      },
      {
        "command": "ssync.startServer",
        "title": "Start ssync Server",
        "category": "ssync",
        "icon": "$(server-process)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ssync-sidebar",
          "title": "ssync",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ssync-sidebar": [
        {
          "id": "ssync.jobsView",
          "name": "Jobs"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "ssync.openDashboard",
          "when": "view == ssync.jobsView",
          "group": "navigation@0"
        },
        {
          "command": "ssync.refreshJobs",
          "when": "view == ssync.jobsView",
          "group": "navigation@1"
        },
        {
          "command": "ssync.syncWorkspace",
          "when": "view == ssync.jobsView",
          "group": "navigation@2"
        },
        {
          "command": "ssync.configure",
          "when": "view == ssync.jobsView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "ssync.viewLogs",
          "when": "viewItem =~ /^job/",
          "group": "inline@1"
        },
        {
          "command": "ssync.cancelJob",
          "when": "viewItem == job-running || viewItem == job-pending",
          "group": "inline@2"
        },
        {
          "command": "ssync.viewLogs",
          "when": "viewItem =~ /^job/",
          "group": "1_job@1"
        },
        {
          "command": "ssync.cancelJob",
          "when": "viewItem == job-running || viewItem == job-pending",
          "group": "1_job@2"
        }
      ],
      "editor/title": [
        {
          "command": "ssync.submitScript",
          "when": "resourceExtname == .sh",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "ssync.submitScript",
          "when": "resourceExtname == .sh",
          "group": "ssync"
        },
        {
          "command": "ssync.syncWorkspace",
          "when": "explorerResourceIsFolder",
          "group": "ssync"
        }
      ]
    },
    "configuration": {
      "title": "ssync",
      "properties": {
        "ssync.apiUrl": {
          "type": "string",
          "default": "https://localhost:8042",
          "description": "URL of the ssync API server"
        },
        "ssync.apiKey": {
          "type": "string",
          "default": "",
          "description": "Legacy API key setting. Prefer ssync: Configure Connection to store keys securely.",
          "scope": "machine",
          "deprecationMessage": "Use ssync: Configure Connection (VS Code SecretStorage)."
        },
        "ssync.pollInterval": {
          "type": "number",
          "default": 120,
          "minimum": 30,
          "description": "History reconciliation and fallback polling interval in seconds. WebSocket updates arrive immediately."
        },
        "ssync.showCompletedJobs": {
          "type": "boolean",
          "default": true,
          "description": "Show recently completed/failed jobs in the tree"
        },
        "ssync.completedJobsWindow": {
          "type": "string",
          "default": "3d",
          "pattern": "^[0-9]+[hdwm]$",
          "description": "How far back to show completed jobs (e.g. 1h, 3d, 1w)"
        },
        "ssync.requestTimeout": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 300,
          "description": "Deadline for each server request in seconds. Launch tracking continues separately."
        },
        "ssync.trustLocalCertificate": {
          "type": "boolean",
          "default": true,
          "description": "Allow self-signed TLS certificates for localhost and loopback addresses only. Remote servers always require valid certificates."
        }
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit && node --check media/dashboard.js && node --check media/logs.js",
    "test": "node test/run.cjs",
    "test:host": "npm run build && node test/host.cjs",
    "test:package": "npm run package && node test/host.cjs --package",
    "demo": "node test/run.cjs --demo",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "node esbuild.js --minify",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
